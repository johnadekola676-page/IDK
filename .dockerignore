# Dependencies (will be installed fresh)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (use Railway variables instead)
.env
.env.*
!.env.example

# Git files
.git/
.gitignore
.gitattributes

# Documentation (not needed in runtime)
*.md
!CLAUDE.md
docs/

# Runtime data (generated during execution)
data/
*.db
*.db-shm
*.db-wal
logs/
*.log

# Sessions and workspace (created at runtime)
sessions/
sandbox-workspace/
obsidian-vault/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.iml

# Build outputs
dist/
build/

# Test files
test/
tests/
*.test.js
*.spec.js
__tests__/
coverage/

# CI/CD files (not needed in container)
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Deployment files (Railway/Docker config, not needed inside container)
railway.toml
Dockerfile*
docker-compose*.yml

# Temporary files
tmp/
temp/
*.tmp

# Package manager files (lock files are kept, but not needed in final image)
.npm/
.yarn/
.pnp.*

# Editor backup files
*~
\#*\#
.\#*

# Python cache (from build tools)
__pycache__/
*.py[cod]
*.pyo

# Playwright browsers (if accidentally downloaded locally)
.cache/
ms-playwright/

# Misc
.editorconfig
.prettierrc*
.eslintrc*
.eslintignore
tsconfig.json
jsconfig.json
