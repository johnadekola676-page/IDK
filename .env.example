# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USER_ID=123456789

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_repository_name

# Application Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
DATABASE_PATH=./data/sessions.db
SESSION_PRUNE_DAYS=30

# Agent Configuration
MAX_RETRY_COUNT=10
COMMAND_TIMEOUT_MS=300000
SANDBOX_WORKSPACE=./sandbox-workspace

# Optional: Logging Configuration
LOG_LEVEL=info

# V2 Enhancements: Token Budget
TOKEN_INPUT_LIMIT=6000
TOKEN_OUTPUT_LIMIT=2000
HANDOFF_TOKEN_THRESHOLD=0.8
HANDOFF_RETRY_THRESHOLD=5

# V2 Enhancements: Obsidian Vault
OBSIDIAN_VAULT_PATH=./obsidian-vault

# V2 Enhancements: Sub-Agents
ENABLE_SUB_AGENTS=true

# V2 Enhancements: Error Learning
ERROR_LEARNING_ENABLED=true

# V2 Enhancements: CLAUDE.md Enforcement
CLAUDE_MD_ENFORCE=true
CLAUDE_MD_PATH=./CLAUDE.md
