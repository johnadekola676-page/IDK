# ============================================================================
# CORE CONFIGURATION
# ============================================================================
NODE_ENV=development
# PORT is automatically set by Railway. For local dev, defaults to 3000 if not set.

# ============================================================================
# TELEGRAM BOT
# ============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USER_ID=your_telegram_user_id_here

# ============================================================================
# MULTI-LLM PROVIDER CONFIGURATION
# ============================================================================
# At least one API key is required

# Groq (Fast, cost-effective)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude (High quality, large context)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (Largest context, multimodal)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# LLM Selection Priority (comma-separated, fallback order)
LLM_PROVIDER_PRIORITY=groq,anthropic,gemini

# Auto-fallback on rate limits or errors
LLM_AUTO_FALLBACK=true

# v2.0 Intelligent Routing Configuration
# Enable task-based provider selection with exponential backoff
LLM_USE_INTELLIGENT_ROUTING=true
# Routes: light/validation → Groq/Flash, complex/generation → Gemini Pro/Groq

# ============================================================================
# ERROR RESOLUTION LOOP
# ============================================================================
AUTO_ERROR_RESOLUTION=true
ERROR_RESOLUTION_MAX_RETRIES=5
AUTO_COMMIT_FIXES=false

# ============================================================================
# GITHUB INTEGRATION
# ============================================================================
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username_here
GITHUB_REPO=your_repo_name_here

# ============================================================================
# INTERFACE MODE CONFIGURATION (Phase 2)
# ============================================================================
# Options: web (default), desktop, cli
# Or use command flags: --web, --desktop, --cli
AGENT_MODE=web

# ============================================================================
# DESKTOP MODE CONFIGURATION
# ============================================================================
# Local project directory to monitor/execute in
DESKTOP_PROJECT_PATH=/path/to/your/project

# Desktop daemon status port (for monitoring)
DESKTOP_DAEMON_PORT=7879

# Allow local terminal execution (DANGEROUS - only for desktop mode)
# Set to "true" only if you trust the agent with your local machine
ALLOW_LOCAL_TERMINAL_EXEC=false

# Whitelist of allowed commands (comma-separated)
DESKTOP_ALLOWED_COMMANDS=npm,git,docker,node,python3,cargo

# ============================================================================
# CLI MODE CONFIGURATION
# ============================================================================
# Enable interactive mode (vs one-shot commands)
CLI_INTERACTIVE=false

# CLI output format (text, json, markdown)
CLI_OUTPUT_FORMAT=text

# CLI verbose mode (show detailed logs)
CLI_VERBOSE=false

# CLI executable name (for symlink)
CLI_EXECUTABLE_NAME=hermes

# ============================================================================
# PHASE 3: MEMORY & PERSISTENCE (Enhanced Obsidian + Handoff)
# ============================================================================

# Obsidian vault path
OBSIDIAN_VAULT_PATH=./obsidian-vault

# Enable live sync (vs fire-and-forget)
OBSIDIAN_LIVE_SYNC=true

# Handoff trigger: context percentage threshold (0.8 = 80%)
HANDOFF_CONTEXT_THRESHOLD=0.8

# Snapshot interval in minutes
SNAPSHOT_INTERVAL_MINUTES=30
