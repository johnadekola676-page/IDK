# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USER_ID=123456789

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_repository_name

# Application Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
DATABASE_PATH=./data/sessions.db
SESSION_PRUNE_DAYS=30

# Agent Configuration
MAX_RETRY_COUNT=10
COMMAND_TIMEOUT_MS=300000
SANDBOX_WORKSPACE=./sandbox-workspace

# Optional: Logging Configuration
LOG_LEVEL=info

# V2 Enhancements: Token Budget
TOKEN_INPUT_LIMIT=6000
TOKEN_OUTPUT_LIMIT=2000
HANDOFF_TOKEN_THRESHOLD=0.8
HANDOFF_RETRY_THRESHOLD=5

# V2 Enhancements: Obsidian Vault
OBSIDIAN_VAULT_PATH=./obsidian-vault

# V2 Enhancements: Sub-Agents
ENABLE_SUB_AGENTS=true

# V2 Enhancements: Error Learning
ERROR_LEARNING_ENABLED=true

# V2 Enhancements: CLAUDE.md Enforcement
CLAUDE_MD_ENFORCE=true
CLAUDE_MD_PATH=./CLAUDE.md

# Web UI Configuration (V3 Feature)
WEB_UI_ORIGIN=*
WEB_UI_TOKEN=your_web_ui_auth_token_here

# ============================================================================
# V3: SOP SYSTEM CONFIGURATION (Claude Code Architecture)
# ============================================================================

# Enable SOP (Standard Operating Procedure) system
# When enabled, uses SOP worksheets and specialist agents
# When disabled, falls back to standard 5-phase loop
ENABLE_SOP=false

# SOP workflow to use (standard-development-task, hotfix-workflow)
SOP_WORKFLOW=standard-development-task

# Maximum retry attempts for SOP steps
SOP_MAX_RETRIES=10

# SOP worksheet directory (must be writable)
SOP_WORKSHEET_DIR=/tmp/volter/sop

# Specialist Agent Configuration
ENABLE_GIT_SPECIALIST=true
ENABLE_CODING_SPECIALIST=true
ENABLE_CONTEXT_SPECIALIST=true
ENABLE_REVIEW_SPECIALIST=true
ENABLE_QA_SPECIALIST=true

# ============================================================================
# V4: COGNITIVE REFLECTION SYSTEM (Think Deeply Architecture)
# ============================================================================

# Layer 1: User Pushback & Clarification Engine (Anti-Slop Gate)
# Analyzes user prompts for ambiguity and forces clarification
ENABLE_PUSHBACK_ENGINE=true

# Layer 2: Test-Driven Auto-Validation Pipeline (Anti-Slop Engine)
# Validates generated code before reporting completion
# Self-corrects via error learning database
ENABLE_AUTO_VALIDATION=true

# Layer 3: Architectural Documentation Handoff
# Automatically documents architectural decisions to docs/ARCHITECTURE.md
ENABLE_ARCH_DOCUMENTATION=true

# Maximum self-correction retry attempts for auto-validator
MAX_SELF_CORRECTION_RETRIES=10
